<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LanFlow.Desktop.Views"
        x:Class="LanFlow.Desktop.Views.SettingsWindow"
        Title="设置"
        Width="760" Height="600"
        MinWidth="700" MinHeight="480"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid RowDefinitions="*,Auto" ColumnDefinitions="190,*">
        <!-- 左侧分类导航（B3-1：对齐 Windows 8 分类结构） -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,0,1,0" Padding="10">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" Margin="6,10,0,12"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <ListBox x:Name="CategoryList" Grid.Row="1" BorderThickness="0"
                         Background="Transparent" SelectionChanged="OnCategoryChanged">
                    <ListBoxItem Content="外观与主题" />
                    <ListBoxItem Content="布局与项目" />
                    <ListBoxItem Content="分组标签" />
                    <ListBoxItem Content="透明度" />
                    <ListBoxItem Content="交互" />
                    <ListBoxItem Content="启动与快捷键" />
                    <ListBoxItem Content="性能" />
                    <ListBoxItem Content="关于" />
                </ListBox>
            </Grid>
        </Border>

        <!-- 右侧内容：固定预览区（仅「布局与项目」页显示，下滑时置顶）+ 可滚动面板 -->
        <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="Auto,*">
            <Border x:Name="PreviewPanel" Grid.Row="0" IsVisible="False"
                    Height="128" Margin="18,18,18,0" ClipToBounds="True"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                <Grid x:Name="PreviewHost" />
            </Border>
            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="16" Margin="18">

                <!-- 1 外观与主题 -->
                <StackPanel x:Name="PanelAppearance" Spacing="12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="主题方案" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" />
                        <ComboBox x:Name="ProfileBox" Width="220" SelectionChanged="OnProfileChanged" />
                        <Grid ColumnDefinitions="*,200">
                            <TextBlock Grid.Column="0" Text="主题配置名称" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBox Grid.Column="1" x:Name="ThemeProfileBox" TextChanged="OnThemeProfileChanged" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="自定义颜色" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Content="保存为风格" FontSize="11" Height="26" Click="OnSaveTheme" />
                        </StackPanel>
                        <StackPanel x:Name="ColorPanel" Spacing="6" />
                    </StackPanel>
                </StackPanel>

                <!-- 2 布局与项目 -->
                <StackPanel x:Name="PanelLayout" Spacing="8" IsVisible="False">
                    <TextBlock Text="排列方式" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" />
                    <Grid ColumnDefinitions="*,200">
                        <TextBlock Grid.Column="0" Text="布局模式" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox Grid.Column="1" x:Name="LayoutBox">
                            <ComboBoxItem Content="平铺" />
                            <ComboBoxItem Content="卡片" />
                        </ComboBox>
                    </Grid>

                    <TextBlock Text="尺寸与密度" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" Margin="0,8,0,0" />
                    <Grid ColumnDefinitions="72,*,Auto">
                        <TextBlock Grid.Column="0" Text="卡片宽度" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Slider Grid.Column="1" x:Name="CardWidthSlider" Minimum="48" Maximum="320" Margin="12,0,8,0" />
                        <TextBlock Grid.Column="2" x:Name="CardWidthValue" FontSize="12" VerticalAlignment="Center" MinWidth="32" TextAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                    <Grid ColumnDefinitions="72,*,Auto">
                        <TextBlock Grid.Column="0" Text="卡片高度" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Slider Grid.Column="1" x:Name="CardHeightSlider" Minimum="48" Maximum="240" Margin="12,0,8,0" />
                        <TextBlock Grid.Column="2" x:Name="CardHeightValue" FontSize="12" VerticalAlignment="Center" MinWidth="32" TextAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                    <Grid ColumnDefinitions="72,*,Auto">
                        <TextBlock Grid.Column="0" Text="图标尺寸" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Slider Grid.Column="1" x:Name="IconSizeSlider" Minimum="24" Maximum="72" Margin="12,0,8,0" />
                        <TextBlock Grid.Column="2" x:Name="IconSizeValue" FontSize="12" VerticalAlignment="Center" MinWidth="32" TextAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                    <Grid ColumnDefinitions="72,*,Auto">
                        <TextBlock Grid.Column="0" Text="文字尺寸" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Slider Grid.Column="1" x:Name="TextSizeSlider" Minimum="10" Maximum="18" Margin="12,0,8,0" />
                        <TextBlock Grid.Column="2" x:Name="TextSizeValue" FontSize="12" VerticalAlignment="Center" MinWidth="32" TextAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                    <Grid ColumnDefinitions="72,*,Auto">
                        <TextBlock Grid.Column="0" Text="项目间距" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Slider Grid.Column="1" x:Name="ItemSpacingSlider" Minimum="0" Maximum="64" Margin="12,0,8,0" />
                        <TextBlock Grid.Column="2" x:Name="ItemSpacingValue" FontSize="12" VerticalAlignment="Center" MinWidth="32" TextAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                    <Grid ColumnDefinitions="72,*,Auto">
                        <TextBlock Grid.Column="0" Text="行间距" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Slider Grid.Column="1" x:Name="RowSpacingSlider" Minimum="0" Maximum="80" Margin="12,0,8,0" />
                        <TextBlock Grid.Column="2" x:Name="RowSpacingValue" FontSize="12" VerticalAlignment="Center" MinWidth="32" TextAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                    <Grid ColumnDefinitions="72,*,Auto">
                        <TextBlock Grid.Column="0" Text="内容边距" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Slider Grid.Column="1" x:Name="ContentPaddingSlider" Minimum="6" Maximum="40" Margin="12,0,8,0" />
                        <TextBlock Grid.Column="2" x:Name="ContentPaddingValue" FontSize="12" VerticalAlignment="Center" MinWidth="32" TextAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                </StackPanel>

                <!-- 3 分组标签 -->
                <StackPanel x:Name="PanelGroups" Spacing="8" IsVisible="False">
                    <TextBlock Text="分组导航" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" />
                    <Grid ColumnDefinitions="*,200">
                        <TextBlock Grid.Column="0" Text="分组栏位置" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox Grid.Column="1" x:Name="GroupBoxLayoutBox">
                            <ComboBoxItem Content="左侧" />
                            <ComboBoxItem Content="顶部" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="切换方式" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" Margin="0,8,0,0" />
                    <views:LabelToggle x:Name="GroupHoverToggle" Title="悬停切换分组" Description="鼠标悬停分组标签自动切换，关闭则需点击" />
                    <Grid ColumnDefinitions="*,200">
                        <TextBlock Grid.Column="0" Text="悬停延迟（毫秒）" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <NumericUpDown Grid.Column="1" x:Name="GroupHoverDelayBox" Minimum="0" Maximum="1000" />
                    </Grid>
                </StackPanel>

                <!-- 4 透明度 -->
                <StackPanel x:Name="PanelTransparency" Spacing="8" IsVisible="False">
                    <TextBlock Text="透明模式" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" />
                    <Grid ColumnDefinitions="*,200">
                        <TextBlock Grid.Column="0" Text="应用范围" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox Grid.Column="1" x:Name="TransparencyModeBox" SelectionChanged="OnTransparencyModeChanged">
                            <ComboBoxItem Content="分层透明" Tag="layered" />
                            <ComboBoxItem Content="整窗透明" Tag="wholeWindow" />
                        </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="*,200">
                        <TextBlock Grid.Column="0" Text="透明度" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                            <Slider Grid.Column="0" x:Name="OpacityBox" Minimum="0.55" Maximum="1" Value="1"
                                    ValueChanged="OnOpacityValueChanged" />
                            <TextBlock Grid.Column="1" x:Name="OpacityValueText" Margin="8,0,0,0"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>
                    </Grid>
                    <Button Content="恢复 85%" Width="120" HorizontalAlignment="Left" Click="OnResetOpacity" />
                    <TextBlock x:Name="TransparencyHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- 5 交互 -->
                <StackPanel x:Name="PanelInteraction" Spacing="8" IsVisible="False">
                    <TextBlock Text="启动项交互" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" />
                    <views:LabelToggle x:Name="OpenSingleClickToggle" Title="单击打开项目" Description="关闭则需双击打开" />
                    <views:LabelToggle x:Name="AnimationToggle" Title="启用动画" Description="界面切换使用过渡动画" />
                    <TextBlock Text="项目信息显示" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" Margin="0,8,0,0" />
                    <views:LabelToggle x:Name="ShowBadgeToggle" Title="显示快捷键角标" Description="在图标右上角显示快捷键" />
                    <views:LabelToggle x:Name="ShowFullToggle" Title="显示完整名称" Description="不截断过长名称" />
                    <views:LabelToggle x:Name="ShowTitleToggle" Title="显示项目标题" Description="在图标下方显示名称" />
                    <TextBlock Text="窗口行为" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" Margin="0,8,0,0" />
                    <views:LabelToggle x:Name="HideOnDeactivateToggle" Title="失焦自动隐藏" Description="窗口失去焦点后自动隐藏到托盘" />
                </StackPanel>

                <!-- 6 启动与快捷键 -->
                <StackPanel x:Name="PanelStartup" Spacing="8" IsVisible="False">
                    <TextBlock Text="快捷键" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" x:Name="HotkeyBox" Watermark="例如 Ctrl+Alt+L" />
                        <Button Grid.Column="1" Content="应用" Margin="8,0,0,0" Click="OnApplyHotkey" />
                    </Grid>
                    <TextBlock x:Name="HotkeyHint" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                    <TextBlock Text="启动" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" Margin="0,8,0,0" />
                    <views:LabelToggle x:Name="StartupToggle" Title="开机自启动" Description="登录系统后自动启动 LanFlow" />
                </StackPanel>

                <!-- 7 性能 -->
                <StackPanel x:Name="PanelPerformance" Spacing="8" IsVisible="False">
                    <TextBlock Text="图标缓存" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="清空已加载的图标缓存" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button Grid.Column="1" Content="清空缓存" Click="OnClearIconCache" />
                    </Grid>
                    <TextBlock x:Name="CacheStatusText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="配置位置" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" Margin="0,8,0,0" />
                    <TextBlock x:Name="ConfigPathText" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button Content="打开配置目录" Width="140" HorizontalAlignment="Left" Click="OnOpenConfigPath" />
                </StackPanel>

                <!-- 8 关于 -->
                <StackPanel x:Name="PanelAbout" Spacing="8" IsVisible="False">
                    <TextBlock Text="LanFlow" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="LanFlow 是一款 Linux（UOS/Deepin）轻量启动与整理工具，支持分组导航、快速搜索、全局热键与自定义主题。"
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="源码：github.com/ZergZFZ/LanFlow（linux 分支）" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="10" Margin="18,14" Background="{DynamicResource FooterBrush}">
            <Button Content="确定" Width="80" Click="OnConfirm" />
            <Button Content="取消" Width="80" Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
