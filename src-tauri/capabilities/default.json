{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "LanFlow 默认权限：窗口控制、启动程序、文件选择对话框",
  "windows": ["main"],
  "permissions": [
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "core:event:default",
    "shell:allow-open",
    "dialog:allow-open"
  ]
}
