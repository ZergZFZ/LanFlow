<Window x:Class="LanFlow.Desktop.Views.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入清单预览"
        Width="920"
        Height="650"
        MinWidth="720"
        MinHeight="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Style="{StaticResource DialogChromeStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid PreviewMouseLeftButtonDown="DialogHeader_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource DialogHeaderStyle}" Text="导入清单预览" />
                    <TextBlock Style="{StaticResource DialogSubtitleStyle}" Text="检查清单内容后确认导入，未确认前不会修改当前配置。" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}" Click="Close_Click" Content="&#xE711;" ToolTip="关闭" />
            </Grid>

            <Border Grid.Row="2" Padding="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="文件：" />
                    <TextBlock Grid.Column="1" Margin="6,0,0,0" MaxWidth="280" FontWeight="SemiBold" Text="{Binding SourceFileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceFilePath}" />
                    <TextBlock Grid.Column="2" Margin="20,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="格式：" />
                    <TextBlock Grid.Column="3" Margin="6,0,0,0" Text="{Binding SchemaVersion}" />
                    <TextBlock Grid.Column="4" Margin="20,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="分组：" />
                    <TextBlock Grid.Column="5" Margin="6,0,0,0" Text="{Binding TotalGroupCount}" />
                    <TextBlock Grid.Column="6" Margin="20,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="项目：" />
                    <TextBlock Grid.Column="7" Margin="6,0,0,0" Text="{Binding TotalItemCount}" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="4"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox VerticalAlignment="Center"
                                          IsThreeState="True"
                                          IsEnabled="{Binding CanSelect}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource WarningTextBrush}" Text="{Binding NoticeText}" />
                                </StackPanel>
                                <Border Grid.Column="2" Padding="8,3" Background="{StaticResource AccentSoftBrush}" CornerRadius="10">
                                    <TextBlock FontSize="11" Foreground="{StaticResource AccentBrush}" Text="{Binding StatusText}" />
                                </Border>
                            </Grid>

                            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,9" BorderBrush="{StaticResource ImportDividerBrush}" BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox VerticalAlignment="Top"
                                                          IsEnabled="{Binding CanSelect}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Column="1" Margin="10,0,12,0" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayPath}" />
                                                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource ErrorTextBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding StatusText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

            <Border Grid.Row="6" Padding="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding SummaryText}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ImportErrorText" Grid.Row="1" Grid.Column="0" Margin="0,8,16,0" Foreground="{StaticResource DangerTextBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                    <StackPanel Grid.RowSpan="2" Grid.Column="1" Margin="24,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                        <Button MinWidth="82" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click" Content="取消" />
                        <Button x:Name="ConfirmImportButton"
                                MinWidth="104"
                                Style="{StaticResource PrimaryButton}"
                                IsDefault="True"
                                IsEnabled="{Binding CanConfirm}"
                                Click="ConfirmImport_Click"
                                Content="确认导入" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
