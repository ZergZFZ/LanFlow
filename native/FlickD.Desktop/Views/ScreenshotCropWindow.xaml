<Window x:Class="FlickD.Desktop.Views.ScreenshotCropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FlickD.Desktop.Views"
        Title="截图"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Focusable="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.BitmapScalingMode="HighQuality"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- 工具条卡片按钮：44x46，上图标 20x20、下中文小标题；悬停用白 8% 叠加，不覆盖激活药丸底色。 -->
        <Style x:Key="ToolCardButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="#ECFFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <Grid>
                                <Border x:Name="HoverFill" Background="Transparent" CornerRadius="9" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverFill" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverFill" Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Opacity" Value="0.88" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- 输出类按钮（保存/复制）：强调色底，与工具按钮在视觉上分层，鼠标可快速定位 -->
        <Style x:Key="AccentCardButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolCardButtonStyle}">
            <Setter Property="Background" Value="#2E4C9AFF" />
            <Setter Property="BorderBrush" Value="#664C9AFF" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Cursor="Cross">
        <!-- 冻结的全屏截图（物理像素整图） -->
        <Image x:Name="FrozenImage" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- 框选阶段：选区外的四块压暗蒙版 + 选区框 + 尺寸胶囊 -->
        <Canvas x:Name="OverlayCanvas" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True" />

        <!-- 标注工作区：裁剪图 → 马赛克层 → 标注矢量层（越靠下越先绘制）
             投影由外层 ShadowHost 承担：EditFrame 自身 ClipToBounds 会裁掉自己的 Effect。 -->
        <Border x:Name="ShadowHost" Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent">
            <Border.Effect>
                <!-- 暗色蒙版上黑色投影不可见，改用与强调色同源的冷光晕，既区分层次又不抢主体 -->
                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.85" Color="#4C9AFF" />
            </Border.Effect>
            <Border x:Name="EditFrame" BorderThickness="1" BorderBrush="#4C9AFF"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    RenderOptions.EdgeMode="Aliased">
                <Border.Clip>
                    <RectangleGeometry x:Name="EditFrameClip" RadiusX="7" RadiusY="7" />
                </Border.Clip>
                <Grid x:Name="EditRoot" Background="Transparent" ClipToBounds="True">
                    <Image x:Name="EditImage" Stretch="Fill" />
                    <Image x:Name="MosaicLayer" Stretch="Fill" IsHitTestVisible="False" />
                    <local:AnnotationVisualHost x:Name="AnnotationHost" IsHitTestVisible="False" />
                    <Canvas x:Name="EditCanvas" Background="Transparent" />
                </Grid>
            </Border>
        </Border>

        <!-- 选区调整手柄层：仅在选中/拖动时交互，空白区域不挡下层 -->
        <Canvas x:Name="HandleCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True" />

        <!-- 标注工具条卡片：与选区同层，位于选区下方或上方 -->
        <Canvas x:Name="ToolLayer">
            <Border x:Name="ToolCard" Visibility="Collapsed"
                    Background="#F31C1C22" BorderBrush="#28FFFFFF" BorderThickness="1"
                    CornerRadius="10" Padding="6"
                    MouseLeftButtonDown="ToolCard_MouseLeftButtonDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.28" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <!-- ① 绘制：形状类放在最左（最高频，鼠标落点最近） -->
                        <Button x:Name="RectButton" Style="{StaticResource ToolCardButtonStyle}" Tag="0" Click="Tool_Click">
                            <StackPanel>
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M2.5,4.5 H17.5 V15.5 H2.5 Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="矩形" Style="{StaticResource ToolCaptionStyle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="EllipseButton" Style="{StaticResource ToolCardButtonStyle}" Tag="6" Click="Tool_Click">
                            <StackPanel>
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M2.5,10 A7.5,5.5 0 1 0 17.5,10 A7.5,5.5 0 1 0 2.5,10 Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="椭圆" Style="{StaticResource ToolCaptionStyle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ArrowButton" Style="{StaticResource ToolCardButtonStyle}" Tag="1" Click="Tool_Click">
                            <StackPanel>
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M4,16 L16,4 M16,4 L9.4,5.2 M16,4 L14.8,10.6"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="箭头" Style="{StaticResource ToolCaptionStyle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PenButton" Style="{StaticResource ToolCardButtonStyle}" Tag="2" Click="Tool_Click">
                            <StackPanel>
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M15.2,4.2 L17.6,6.6 L11.4,12.8 L9,10.4 Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" />
                                        <Path Data="M9,10.4 L7.2,16 L11.4,12.8 Z"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <Path Data="M13.8,5.6 L16.2,8"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.2" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="画笔" Style="{StaticResource ToolCaptionStyle}" />
                            </StackPanel>
                        </Button>

                        <Border Width="9" Height="30" VerticalAlignment="Center">
                            <Rectangle Width="1" Fill="#1EFFFFFF" />
                        </Border>

                        <!-- ② 标记：马赛克/序号/文字 -->
                        <Button x:Name="MosaicButton" Style="{StaticResource ToolCardButtonStyle}" Tag="3" Click="Tool_Click">
                            <StackPanel>
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M1.5,1.5 H7.1 V7.1 H1.5 Z M7.5,1.5 H13.1 V7.1 H7.5 Z M13.5,1.5 H19.1 V7.1 H13.5 Z M1.5,7.5 H7.1 V13.1 H1.5 Z M7.5,7.5 H13.1 V13.1 H7.5 Z M13.5,7.5 H19.1 V13.1 H13.5 Z M1.5,13.5 H7.1 V19.1 H1.5 Z M7.5,13.5 H13.1 V19.1 H7.5 Z M13.5,13.5 H19.1 V19.1 H13.5 Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.1" />
                                        <Path Data="M1.5,1.5 H7.1 V7.1 H1.5 Z M13.5,1.5 H19.1 V7.1 H13.5 Z M7.5,7.5 H13.1 V13.1 H7.5 Z M1.5,13.5 H7.1 V19.1 H1.5 Z M13.5,13.5 H19.1 V19.1 H13.5 Z"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="马赛克" Style="{StaticResource ToolCaptionStyle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NumberButton" Style="{StaticResource ToolCardButtonStyle}" Tag="4" Click="Tool_Click">
                            <StackPanel>
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="20" Height="20">
                                        <Ellipse Width="15" Height="15" Canvas.Left="2.5" Canvas.Top="2.5"
                                                 Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <Path Data="M10.6,6.4 V13.8 M10.6,6.4 L7.6,8.9"
                                              Stroke="#FF1C1C22" StrokeThickness="1.9"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="序号" Style="{StaticResource ToolCaptionStyle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TextButton" Style="{StaticResource ToolCardButtonStyle}" Tag="5" Click="Tool_Click">
                            <StackPanel>
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M4.5,5 H15.5 M10,5 V15.5"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="文字" Style="{StaticResource ToolCaptionStyle}" />
                            </StackPanel>
                        </Button>

                        <Border Width="9" Height="30" VerticalAlignment="Center">
                            <Rectangle Width="1" Fill="#1EFFFFFF" />
                        </Border>

                        <!-- ③ 属性与修正：颜色/撤销紧邻，画完立刻调 -->
                        <Button x:Name="ColorButton" Style="{StaticResource ToolCardButtonStyle}" Tag="7" Click="Tool_Click"
                                ToolTip="颜色（C 循环切换，点击展开调色板）">
                            <StackPanel>
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="20" Height="20">
                                        <Ellipse x:Name="ColorSwatch" Width="16.8" Height="16.8" Canvas.Left="1.6" Canvas.Top="1.6"
                                                 Fill="#FFE8453B" Stroke="#B4FFFFFF" StrokeThickness="1.2" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="颜色" Style="{StaticResource ToolCaptionStyle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="UndoButton" Style="{StaticResource ToolCardButtonStyle}" Tag="8" Click="Tool_Click">
                            <StackPanel>
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M6.8,7.2 H13.2 V13 M6.8,7.2 L10,3.8 M6.8,7.2 L10,10.6"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="撤销" Style="{StaticResource ToolCaptionStyle}" />
                            </StackPanel>
                        </Button>

                        <Border Width="9" Height="30" VerticalAlignment="Center">
                            <Rectangle Width="1" Fill="#1EFFFFFF" />
                        </Border>

                        <!-- ④ 取字 -->
                        <Button x:Name="OcrButton" Style="{StaticResource ToolCardButtonStyle}" Tag="9" Click="Tool_Click"
                                ToolTip="取字（T）：识别选区文字">
                            <StackPanel>
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M3.5,3.5 H16.5 M10,3.5 V16.5 M6.6,16.5 H13.4"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="取字" Style="{StaticResource ToolCaptionStyle}" />
                            </StackPanel>
                        </Button>

                        <Border Width="9" Height="30" VerticalAlignment="Center">
                            <Rectangle Width="1" Fill="#1EFFFFFF" />
                        </Border>

                        <!-- ⑤ 输出：保存/复制固定在最右，强调色，收尾动作一次定位 -->
                        <Button x:Name="SaveButton" Style="{StaticResource AccentCardButtonStyle}" Tag="10" Click="Tool_Click"
                                ToolTip="保存（S）：一键存入图片文件夹；Ctrl+S 另存为">
                            <StackPanel>
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M4.5,3.5 H13.5 L16.5,6.5 V16.5 H4.5 Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        <Path Data="M7.5,3.5 V8.5 H12.5 V3.5 M7,16 V12.2 H13 V16"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="保存" Style="{StaticResource ToolCaptionStyle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CopyButton" Style="{StaticResource AccentCardButtonStyle}" Tag="11" Click="Tool_Click"
                                ToolTip="复制（Enter / Ctrl+C）：写入剪贴板并关闭">
                            <StackPanel>
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M6.5,3.5 H13.5 V12.5 H6.5 Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.7" StrokeLineJoin="Round" />
                                        <Path Data="M3.8,6.8 H3.5 V16.5 H10.5 V16.2"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.7" StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="复制" Style="{StaticResource ToolCaptionStyle}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 调色板浮层：点击「颜色」时从工具条上/下方展开，替代原来的循环切换 -->
            <Border x:Name="PaletteFlyout" Visibility="Collapsed" Opacity="0"
                    Background="#F31C1C22" BorderBrush="#28FFFFFF" BorderThickness="1"
                    CornerRadius="10" Padding="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.32" Color="Black" />
                </Border.Effect>
                <StackPanel x:Name="PaletteHost" Orientation="Horizontal" />
            </Border>
        </Canvas>

        <!-- 放大镜：框选阶段跟随鼠标，8 倍最近邻取样 + 坐标/取色读数 -->
        <Canvas x:Name="MagnifierLayer" IsHitTestVisible="False" Visibility="Collapsed">
            <Border x:Name="MagnifierCard" Background="#F31C1C22" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <Grid Width="144" Height="88">
                        <Image x:Name="MagnifierImage" Stretch="Fill"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Line X1="72" Y1="5" X2="72" Y2="83" Stroke="#D2F04438" StrokeThickness="1" />
                        <Line X1="5" Y1="44" X2="139" Y2="44" Stroke="#D2F04438" StrokeThickness="1" />
                    </Grid>
                    <TextBlock x:Name="MagnifierText" Height="19" TextAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Consolas" FontSize="11" FontWeight="Medium"
                               Foreground="#E8FFFFFF" />
                </StackPanel>
            </Border>
        </Canvas>

        <!-- 框选阶段提示条 -->
        <Border x:Name="HintBar" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                Background="#B4000000" CornerRadius="6" Padding="16,6" IsHitTestVisible="False">
            <TextBlock x:Name="HintText" Text="拖动框选截图区域　右键/Esc 取消" Foreground="White" FontSize="13" />
        </Border>
    </Grid>
</Window>
