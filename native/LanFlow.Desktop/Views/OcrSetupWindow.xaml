<Window x:Class="LanFlow.Desktop.Views.OcrSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="启用本地离线取字"
        Width="540"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Border Background="#F21C1C22" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="12">
        <StackPanel Margin="22">
            <TextBlock Text="启用本地离线取字"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#F5F7FC" />

            <TextBlock Margin="0,10,0,0"
                       FontSize="12"
                       Foreground="#ADB5C7"
                       TextWrapping="Wrap"
                       Text="取字需要独立的本地组件包（约 22 MB）：ONNX Runtime + PP-OCRv5 模型 + VC++ 运行库。组件从 GitHub Release 下载，安装前逐个文件校验 SHA-256。识别全程离线，不上传任何截图。主程序未启用前不会加载或检查该组件。" />

            <TextBlock x:Name="StatusText"
                       Margin="0,12,0,0"
                       FontSize="12"
                       Foreground="#ADB5C7"
                       TextWrapping="Wrap"
                       Text="点击“同意并下载”开始安装；离线环境可选择手动导入组件包。" />

            <ProgressBar x:Name="Progress"
                         Margin="0,10,0,0"
                         Height="4"
                         Minimum="0"
                         Maximum="1"
                         Visibility="Collapsed"
                         Foreground="#4C9AFF"
                         Background="#2A3040"
                         BorderThickness="0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" Width="88" Height="32" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button Content="从文件导入" Width="104" Height="32" Margin="0,0,10,0" Click="Import_Click" />
                <Button Content="同意并下载" Width="112" Height="32" Click="Download_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
