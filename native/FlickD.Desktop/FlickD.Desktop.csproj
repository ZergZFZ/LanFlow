<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FlickD</AssemblyName>
    <RootNamespace>FlickD.Desktop</RootNamespace>
    <Version>2.0.1</Version>
    <AssemblyVersion>2.0.1.0</AssemblyVersion>
    <FileVersion>2.0.1.0</FileVersion>
    <ApplicationIcon>Assets\FlickD.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\FlickD.png" />
    <EmbeddedResource Include="Assets\FlickD.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlickD.Core\FlickD.Core.csproj" />
  </ItemGroup>
</Project>
