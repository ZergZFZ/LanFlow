<Window x:Class="LanFlow.Desktop.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择颜色" Width="430"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindowStyle}"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp" Deactivated="Window_Deactivated">
    <Border Style="{StaticResource DialogChromeStyle}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid PreviewMouseLeftButtonDown="DialogHeader_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource DialogHeaderStyle}" Text="选择颜色"/>
                    <TextBlock Style="{StaticResource DialogSubtitleStyle}" Text="拖动色相和明暗区域，或直接输入 HEX 色值。"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}" Click="Close_Click" Content="&#xE711;" ToolTip="关闭" />
            </Grid>
            <Grid Grid.Row="2" Height="260">
                <Border x:Name="Spectrum" Background="Transparent" CornerRadius="9" MouseLeftButtonDown="Spectrum_MouseLeftButtonDown" MouseMove="Spectrum_MouseMove">
                    <Grid ClipToBounds="True">
                        <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0"/><GradientStop x:Name="HueStop" Color="#FF0000" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                        <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#FF000000" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                        <Canvas IsHitTestVisible="False"><Ellipse x:Name="SpectrumMarker" Width="16" Height="16" Stroke="White" StrokeThickness="2" Fill="Transparent"/></Canvas>
                    </Grid>
                </Border>
                <Border Width="58" Height="58" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource FocusBorderBrush}" BorderThickness="1"><Border x:Name="PreviewSwatch" Margin="5" CornerRadius="5"/></Border>
            </Grid>
            <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                <Border x:Name="HueBar" Height="18" VerticalAlignment="Center" CornerRadius="9" ClipToBounds="True" MouseLeftButtonDown="HueBar_MouseLeftButtonDown" MouseMove="HueBar_MouseMove"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF0000" Offset="0"/><GradientStop Color="#FFFF00" Offset="0.17"/><GradientStop Color="#FF00FF00" Offset="0.33"/><GradientStop Color="#FF00FFFF" Offset="0.5"/><GradientStop Color="#FF0000FF" Offset="0.67"/><GradientStop Color="#FFFF00FF" Offset="0.83"/><GradientStop Color="#FFFF0000" Offset="1"/></LinearGradientBrush></Border.Background><Border x:Name="HueMarker" Width="4" Background="White" HorizontalAlignment="Left" IsHitTestVisible="False"/></Border>
                <TextBox x:Name="HexBox" Grid.Column="2" TextChanged="HexBox_TextChanged"/>
            </Grid>
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button MinWidth="72" Content="取消" IsCancel="True"/>
                <Button MinWidth="72" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="应用颜色" IsDefault="True" Click="Apply_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
