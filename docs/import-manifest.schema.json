{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ZergZFZ/LanFlow/main/docs/import-manifest.schema.json",
  "title": "LanFlow Import Manifest v1.0",
  "description": "LanFlow 批量导入清单 v1.0。清单仅描述待导入的分组和启动项目，不包含 LanFlow 内部配置字段。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "groups"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "description": "可选的 JSON Schema 地址，用于 Agent、编辑器和校验工具识别本契约。"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0",
      "description": "导入清单契约版本；v1.0 客户端仅接受精确值 1.0。"
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "description": "按清单顺序进入导入预览的分组列表。",
      "items": {
        "$ref": "#/$defs/group"
      }
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "items"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S",
          "description": "分组名称；LanFlow 会去除首尾空白，处理后不得为空，且不得超过 80 个字符。"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "description": "该分组中待导入的启动项目。",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S",
          "description": "启动项目显示名称；LanFlow 会去除首尾空白，处理后不得为空，且不得超过 160 个字符。"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "待启动的文件、目录或 .lnk 路径。Schema 仅要求非空；Windows 完整路径、规范化、存在性和可访问性由 LanFlow Core 校验。"
        }
      }
    }
  }
}
