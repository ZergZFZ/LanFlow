<Window x:Class="LanFlow.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LanFlow.Desktop.Controls"
        Title="LanFlow"
        Icon="Assets/LanFlow.png"
        Width="760"
        Height="550"
        MinWidth="520"
        MinHeight="380"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <ItemsPanelTemplate x:Key="VirtualizingWrapItemsPanel">
            <controls:VirtualizingWrapPanel
                ItemWidth="{Binding DataContext.Settings.CardWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                ItemHeight="{Binding DataContext.Settings.CardHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"
                HorizontalSpacing="{Binding DataContext.Settings.ItemSpacing, RelativeSource={RelativeSource AncestorType=ListBox}}"
                VerticalSpacing="{Binding DataContext.Settings.RowSpacing, RelativeSource={RelativeSource AncestorType=ListBox}}"
                BufferRows="1" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="VirtualizingListItemsPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tab" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tab" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="iconButton" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="iconButton" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LauncherTile" TargetType="ListBoxItem" BasedOn="{StaticResource LauncherItemContainerStyle}">
            <Setter Property="Width"
                    Value="{Binding DataContext.Settings.CardWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            <Setter Property="Height"
                    Value="{Binding DataContext.Settings.CardHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            <Setter Property="Margin"
                    Value="{Binding DataContext.Settings.ItemSpacing, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource DoubleToUniformThicknessConverter}, ConverterParameter=2}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="tile"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tile" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tile" Property="Background" Value="{DynamicResource ItemSelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                                <Setter TargetName="tile" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LauncherCard" TargetType="ListBoxItem" BasedOn="{StaticResource LauncherTile}" />
        <Style x:Key="LauncherList" TargetType="ListBoxItem" BasedOn="{StaticResource LauncherItemContainerStyle}">
            <Setter Property="Height" Value="64" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="listRow"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="listRow" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="listRow" Property="Background" Value="{DynamicResource ItemSelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="listRow" Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                                <Setter TargetName="listRow" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LauncherContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer CanContentScroll="False"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LauncherMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="HeaderHost" Grid.Column="0" ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <Path x:Name="Arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 0 8 Z" Fill="{DynamicResource SecondaryTextBrush}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Right" HorizontalOffset="2" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" PopupAnimation="Fade">
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                                        <ScrollViewer CanContentScroll="False" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource GroupTabSelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource GroupTabSelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="TileItemTemplate">
            <Grid Margin="6" PreviewMouseRightButtonDown="Item_PreviewMouseRightButtonDown" ContextMenuOpening="ItemContextMenu_Opening">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Image x:Name="ItemIcon"
                       Width="{Binding DataContext.Settings.IconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                       Height="{Binding DataContext.Settings.IconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Source="{Binding IconImage}"
                       Stretch="Uniform" />
                <TextBlock x:Name="ItemName"
                           Grid.Row="1"
                           Margin="2,4,2,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Text="{Binding DisplayName}"
                           FontSize="{Binding DataContext.Settings.TextSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                           Visibility="{Binding DataContext.Settings.ShowItemTitle, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BooleanToVisibilityConverter}}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap"
                           MaxHeight="32" />
                <Button x:Name="ItemDeleteButton" Grid.Row="0" Tag="DeleteItem" Click="DeleteItem_Click" PreviewMouseDoubleClick="ItemDeleteButton_PreviewMouseDoubleClick" MouseEnter="DeleteButton_MouseEnter" MouseLeave="DeleteButton_MouseLeave" ToolTip="删除" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" Width="20" Height="20" FontSize="11" Foreground="{DynamicResource PrimaryOnAccentTextBrush}" Background="{DynamicResource DangerBrush}" Content="&#xE74D;"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsEditMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CardItemTemplate">
            <Grid Margin="4" PreviewMouseRightButtonDown="Item_PreviewMouseRightButtonDown" ContextMenuOpening="ItemContextMenu_Opening">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="ItemIcon"
                       Width="{Binding DataContext.Settings.IconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                       Height="{Binding DataContext.Settings.IconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Source="{Binding IconImage}"
                       Stretch="Uniform" />
                <TextBlock x:Name="ItemName"
                           Grid.Column="1"
                           Margin="8,0,6,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Text="{Binding DisplayName}"
                           FontSize="{Binding DataContext.Settings.TextSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                           Visibility="{Binding DataContext.Settings.ShowItemTitle, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BooleanToVisibilityConverter}}"
                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="ItemDeleteButton"
                        Grid.Column="2"
                        Tag="DeleteItem"
                        Width="20"
                        Height="20"
                        FontSize="11"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource PrimaryOnAccentTextBrush}"
                        Background="{DynamicResource DangerBrush}"
                        Content="&#xE74D;"
                        ToolTip="删除"
                        Click="DeleteItem_Click"
                        PreviewMouseDoubleClick="ItemDeleteButton_PreviewMouseDoubleClick"
                        MouseEnter="DeleteButton_MouseEnter"
                        MouseLeave="DeleteButton_MouseLeave">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsEditMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="AppearanceRoot">
        <Border x:Name="SurfaceRoot"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource WindowBorderBrush}"
                BorderThickness="1"
                CornerRadius="14" />
        <Border Background="Transparent" CornerRadius="14">
            <Grid x:Name="ContentRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="38" />
            </Grid.RowDefinitions>

            <Grid x:Name="LauncherLayout" Grid.Row="0" Margin="24,16,24,12" PreviewMouseLeftButtonDown="LauncherLayout_PreviewMouseLeftButtonDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition x:Name="GroupRow" Height="0" />
                    <RowDefinition x:Name="ContentRow" Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="GroupColumn" Width="132" />
                    <ColumnDefinition x:Name="GroupSeparatorColumn" Width="14" />
                    <ColumnDefinition x:Name="ContentColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Row="0" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent" CornerRadius="12" ToolTip="LanFlow">
                        <Image Source="Assets/LanFlow.png" Stretch="Uniform" />
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" Grid.Column="0" Margin="8,0,2,0" Height="38" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextBrush}" CaretBrush="{DynamicResource PrimaryTextBrush}" FontSize="14" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBox_KeyDown" />
                            <TextBlock Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="搜索全部软件" />
                            <TextBlock Grid.Column="0" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource SecondaryTextBrush}" Text="输入以搜索全部软件…">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>

                <controls:GroupNavigationControl
                    x:Name="GroupNavigation"
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,12,0,0"
                    ItemsSource="{Binding Groups}"
                    SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                    GroupLayout="{Binding Settings.GroupLayout}"
                    GroupLabelSize="{Binding Settings.GroupLabelSize}"
                    GroupLabelFontSize="{Binding Settings.GroupLabelFontSize}"
                    GroupNavigationWidth="{Binding Settings.GroupNavigationWidth}"
                    GroupInvoked="GroupNavigation_GroupInvoked"
                    GroupHovered="GroupNavigation_GroupHovered"
                    GroupDragHovered="GroupNavigation_GroupDragHovered"
                    GroupDropped="GroupNavigation_GroupDropped"
                    PreviewMouseRightButtonDown="GroupNavigation_PreviewMouseRightButtonDown" />
                <Border x:Name="GroupSeparator" Grid.Row="2" Grid.Column="1" Margin="5,12,5,0" Background="{DynamicResource WindowBorderBrush}" CornerRadius="1" />

                <Grid x:Name="ItemListHost" Grid.Row="2" Grid.Column="2" Margin="0,4,0,0">
                    <ListBox x:Name="ItemList"
                             Padding="6"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ItemsPanel="{StaticResource VirtualizingWrapItemsPanel}"
                             ItemsSource="{Binding VisibleItems}"
                             ItemContainerStyle="{StaticResource LauncherTile}"
                             ItemTemplate="{StaticResource TileItemTemplate}"
                             AllowDrop="True"
                             DragOver="ItemList_DragOver"
                             Drop="ItemList_Drop"
                             PreviewKeyDown="ItemList_PreviewKeyDown"
                             SelectionChanged="ItemList_SelectionChanged"
                             PreviewMouseMove="ItemList_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="ItemList_PreviewMouseLeftButtonUp"
                             MouseDoubleClick="ItemList_MouseDoubleClick"
                             PreviewMouseLeftButtonDown="ItemList_PreviewMouseLeftButtonDown" />
                </Grid>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource MutedSurfaceBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,13,13">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding StatusText}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock x:Name="EditHint" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource WarningBrush}" Visibility="Collapsed" Text="编辑中" />
                        <Button Style="{StaticResource IconButton}" Click="ToggleEditMode_Click" ToolTip="编辑页面">&#xE70F;</Button>
                        <Button Style="{StaticResource IconButton}" Click="ImportManifest_Click" ToolTip="导入清单">&#xE8B5;</Button>
                        <Button Style="{StaticResource IconButton}" Click="AddGroup_Click" ToolTip="新建分组">&#xE710;</Button>
                        <Button Style="{StaticResource IconButton}" Click="OpenSettings_Click" ToolTip="系统设置">&#xE713;</Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Thumb x:Name="ResizeGrip"
                   Grid.RowSpan="2"
                   Width="18"
                   Height="18"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,6,6"
                   Panel.ZIndex="1"
                   Cursor="SizeNWSE"
                   DragDelta="ResizeGrip_DragDelta"
                   ToolTip="拖动调整窗口大小">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="18" Height="18" Opacity="0.7">
                            <Path Data="M 6,16 L 16,6 M 10,16 L 16,10 M 14,16 L 16,14"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <StackPanel x:Name="EmptyPanel" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock HorizontalAlignment="Center" FontSize="34" Foreground="{DynamicResource SecondaryTextBrush}" Text="＋" />
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Text="此分组还没有启动项目，可将文件拖放到这里添加" />
            </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="FeedbackRoot" Panel.ZIndex="10">
            <Grid x:Name="NewGroupOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="{DynamicResource ModalScrimBrush}">
                <Border Width="360" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.4" Color="{DynamicResource ShadowColor}" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="新建分组" />
                        <StackPanel Grid.Row="1" Margin="0,16,0,0">
                            <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="分组名称" />
                            <TextBox x:Name="NewGroupNameBox" Height="34" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Foreground="{DynamicResource PrimaryTextBrush}" CaretBrush="{DynamicResource PrimaryTextBrush}" KeyDown="NewGroupNameBox_KeyDown" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button MinWidth="68" Height="30" Margin="0,0,8,0" Background="Transparent" BorderBrush="{DynamicResource DividerBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Click="CancelNewGroup_Click" Content="取消" />
                            <Button MinWidth="68" Height="30" Background="{DynamicResource GroupTabSelectedBrush}" BorderBrush="{DynamicResource GroupTabSelectedBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Click="ConfirmNewGroup_Click" Content="创建" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
