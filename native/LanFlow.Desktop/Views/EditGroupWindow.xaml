<Window x:Class="LanFlow.Desktop.Views.EditGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑分组"
        Width="390"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindowStyle}">
    <Border Style="{StaticResource DialogChromeStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" PreviewMouseLeftButtonDown="DialogHeader_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource DialogHeaderStyle}" Text="分组名称" />
                    <TextBlock Style="{StaticResource DialogSubtitleStyle}" Text="为你的启动项目创建清晰的分类。" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}" Click="Close_Click" Content="&#xE711;" ToolTip="关闭" />
            </Grid>
            <TextBlock Grid.Row="2" Style="{StaticResource DialogFieldLabelStyle}" Text="名称" />
            <TextBox x:Name="NameTextBox" Grid.Row="4" MinWidth="320" />
            <StackPanel Grid.Row="6" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="72" IsCancel="True" Content="取消" />
                <Button MinWidth="72" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Confirm_Click" Content="保存" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
