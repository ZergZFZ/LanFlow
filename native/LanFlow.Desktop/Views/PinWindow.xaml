<Window x:Class="LanFlow.Desktop.Views.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanFlow 贴图"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Focusable="True"
        Opacity="0"
        KeyDown="Window_KeyDown">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="复制图像" Click="Copy_Click" />
            <MenuItem Header="另存为 PNG…" Click="SaveAs_Click" />
            <Separator />
            <MenuItem Header="放大" Click="ZoomIn_Click" />
            <MenuItem Header="缩小" Click="ZoomOut_Click" />
            <MenuItem Header="原始大小" Click="ActualSize_Click" />
            <Separator />
            <MenuItem Header="关闭" Click="Close_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="Root" Background="Transparent">
        <Border BorderBrush="#6EFFFFFF" BorderThickness="1">
            <Image x:Name="PinImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>

        <!-- 缩放百分比胶囊：1.5 秒后自动隐藏 -->
        <Canvas IsHitTestVisible="False">
            <Border x:Name="SizePill" Visibility="Collapsed"
                    Background="#CD12121A" BorderBrush="#78FFFFFF" BorderThickness="1"
                    CornerRadius="3" Padding="6,3,6,3" Canvas.Left="6" Canvas.Top="6">
                <TextBlock x:Name="SizePillText" Foreground="#F0FFFFFF" FontSize="11" />
            </Border>
        </Canvas>

        <!-- 右下角缩放手柄：两色三线，浅色截图上也可见 -->
        <Canvas Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,1,1" IsHitTestVisible="False">
            <Line X1="13" Y1="4" X2="4" Y2="13" Stroke="#8C000000" StrokeThickness="1" />
            <Line X1="12" Y1="4" X2="4" Y2="12" Stroke="#8CFFFFFF" StrokeThickness="1" />
            <Line X1="13" Y1="8" X2="8" Y2="13" Stroke="#8C000000" StrokeThickness="1" />
            <Line X1="12" Y1="8" X2="8" Y2="12" Stroke="#8CFFFFFF" StrokeThickness="1" />
            <Line X1="13" Y1="12" X2="12" Y2="13" Stroke="#8C000000" StrokeThickness="1" />
            <Line X1="12" Y1="12" X2="12" Y2="12" Stroke="#8CFFFFFF" StrokeThickness="1" />
        </Canvas>
    </Grid>
</Window>
