<Window x:Class="LanFlow.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanFlow 设置"
        Width="900"
        Height="720"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource CompactTextBoxStyle}" />
        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ChoiceChipStyle" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChipBorder"
                                MinWidth="{TemplateBinding MinWidth}"
                                Height="{TemplateBinding Height}"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Small}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource ItemSelectedBrush}" />
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                                <Setter TargetName="ChipBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ChipBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ColorPickerButtonStyle" TargetType="Button" BasedOn="{StaticResource CommandButtonStyle}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="184" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource WindowBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="14,18,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1"
                           Margin="0,4,0,0"
                           Text="按功能分类调整 LanFlow"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <ListBox x:Name="CategoryList"
                         Grid.Row="3"
                         Width="184"
                         Margin="-8,0"
                         Padding="0"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource SettingsCategoryItemStyle}"
                         SelectionChanged="CategoryList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding Description}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Padding="24,18,24,14"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedCategory.Title}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding SelectedCategory.Description}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="CategoryContentScrollViewer"
                          Grid.Row="1"
                          Padding="24,18,18,24"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel x:Name="AppearancePanel">
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="主题方案" Style="{StaticResource SettingsSectionHeaderStyle}" />
                                <Border Style="{StaticResource SettingsFieldRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="主题" Style="{StaticResource SettingsFieldTitleStyle}" />
                                            <TextBlock Text="使用深色、浅色或自定义配色。" Style="{StaticResource SettingsFieldDescriptionStyle}" />
                                        </StackPanel>
                                        <ComboBox x:Name="ThemePresetCombo"
                                                  Grid.Column="1"
                                                  Style="{StaticResource SettingsComboBoxStyle}"
                                                  SelectionChanged="ThemePresetCombo_SelectionChanged">
                                            <ComboBoxItem Content="深色（默认）" Tag="dark" />
                                            <ComboBoxItem Content="浅色" Tag="light" />
                                            <ComboBoxItem Content="自定义" Tag="custom" />
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <Border Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="主题配置名称" Style="{StaticResource SettingsFieldTitleStyle}" />
                                            <TextBlock Text="用于标识当前自定义主题方案。" Style="{StaticResource SettingsFieldDescriptionStyle}" />
                                        </StackPanel>
                                        <TextBox x:Name="ThemeProfileBox" Grid.Column="1" TextChanged="ThemeProfileBox_TextChanged" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="自定义颜色" Style="{StaticResource SettingsSectionHeaderStyle}" />
                                <TextBlock Margin="0,0,0,12"
                                           Text="可直接输入十六进制颜色，也可点击色块打开颜色选择器。"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="12" />
                                <UniformGrid Columns="2">
                                    <Grid Margin="0,0,14,10"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="面板" VerticalAlignment="Center" /><TextBox x:Name="PanelColorBox" Grid.Column="1" TextChanged="ThemeColorChanged" /><Button Grid.Column="2" Tag="PanelColorBox" Style="{StaticResource ColorPickerButtonStyle}" Click="ColorPicker_Click"><Border x:Name="PanelColorBoxSwatch" Width="18" Height="18" CornerRadius="4" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" /></Button></Grid>
                                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="面板边框" VerticalAlignment="Center" /><TextBox x:Name="PanelBorderColorBox" Grid.Column="1" TextChanged="ThemeColorChanged" /><Button Grid.Column="2" Tag="PanelBorderColorBox" Style="{StaticResource ColorPickerButtonStyle}" Click="ColorPicker_Click"><Border x:Name="PanelBorderColorBoxSwatch" Width="18" Height="18" CornerRadius="4" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" /></Button></Grid>
                                    <Grid Margin="0,0,14,10"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="项目表面" VerticalAlignment="Center" /><TextBox x:Name="SurfaceColorBox" Grid.Column="1" TextChanged="ThemeColorChanged" /><Button Grid.Column="2" Tag="SurfaceColorBox" Style="{StaticResource ColorPickerButtonStyle}" Click="ColorPicker_Click"><Border x:Name="SurfaceColorBoxSwatch" Width="18" Height="18" CornerRadius="4" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" /></Button></Grid>
                                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="项目边框" VerticalAlignment="Center" /><TextBox x:Name="SurfaceBorderColorBox" Grid.Column="1" TextChanged="ThemeColorChanged" /><Button Grid.Column="2" Tag="SurfaceBorderColorBox" Style="{StaticResource ColorPickerButtonStyle}" Click="ColorPicker_Click"><Border x:Name="SurfaceBorderColorBoxSwatch" Width="18" Height="18" CornerRadius="4" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" /></Button></Grid>
                                    <Grid Margin="0,0,14,10"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="页脚" VerticalAlignment="Center" /><TextBox x:Name="FooterColorBox" Grid.Column="1" TextChanged="ThemeColorChanged" /><Button Grid.Column="2" Tag="FooterColorBox" Style="{StaticResource ColorPickerButtonStyle}" Click="ColorPicker_Click"><Border x:Name="FooterColorBoxSwatch" Width="18" Height="18" CornerRadius="4" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" /></Button></Grid>
                                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="主要文字" VerticalAlignment="Center" /><TextBox x:Name="PrimaryTextColorBox" Grid.Column="1" TextChanged="ThemeColorChanged" /><Button Grid.Column="2" Tag="PrimaryTextColorBox" Style="{StaticResource ColorPickerButtonStyle}" Click="ColorPicker_Click"><Border x:Name="PrimaryTextColorBoxSwatch" Width="18" Height="18" CornerRadius="4" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" /></Button></Grid>
                                    <Grid Margin="0,0,14,10"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="次要文字" VerticalAlignment="Center" /><TextBox x:Name="SecondaryTextColorBox" Grid.Column="1" TextChanged="ThemeColorChanged" /><Button Grid.Column="2" Tag="SecondaryTextColorBox" Style="{StaticResource ColorPickerButtonStyle}" Click="ColorPicker_Click"><Border x:Name="SecondaryTextColorBoxSwatch" Width="18" Height="18" CornerRadius="4" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" /></Button></Grid>
                                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="强调色" VerticalAlignment="Center" /><TextBox x:Name="AccentColorBox" Grid.Column="1" TextChanged="ThemeColorChanged" /><Button Grid.Column="2" Tag="AccentColorBox" Style="{StaticResource ColorPickerButtonStyle}" Click="ColorPicker_Click"><Border x:Name="AccentColorBoxSwatch" Width="18" Height="18" CornerRadius="4" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" /></Button></Grid>
                                    <Grid Margin="0,0,14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="悬停色" VerticalAlignment="Center" /><TextBox x:Name="HoverColorBox" Grid.Column="1" TextChanged="ThemeColorChanged" /><Button Grid.Column="2" Tag="HoverColorBox" Style="{StaticResource ColorPickerButtonStyle}" Click="ColorPicker_Click"><Border x:Name="HoverColorBoxSwatch" Width="18" Height="18" CornerRadius="4" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" /></Button></Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="图标底色" VerticalAlignment="Center" /><TextBox x:Name="IconSurfaceColorBox" Grid.Column="1" TextChanged="ThemeColorChanged" /><Button Grid.Column="2" Tag="IconSurfaceColorBox" Style="{StaticResource ColorPickerButtonStyle}" Click="ColorPicker_Click"><Border x:Name="IconSurfaceColorBoxSwatch" Width="18" Height="18" CornerRadius="4" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" /></Button></Grid>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="LayoutPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="排列方式" Style="{StaticResource SettingsSectionHeaderStyle}" />
                                <Border Padding="0,4,0,12">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <RadioButton x:Name="GridLayoutRadio" GroupName="LayoutMode" Tag="grid" Content="网格" Style="{StaticResource ChoiceChipStyle}" Checked="LayoutMode_Changed" />
                                        <RadioButton x:Name="ListLayoutRadio" GroupName="LayoutMode" Tag="list" Content="列表" Style="{StaticResource ChoiceChipStyle}" Checked="LayoutMode_Changed" />
                                        <RadioButton x:Name="CardLayoutRadio" GroupName="LayoutMode" Tag="card" Content="卡片" Style="{StaticResource ChoiceChipStyle}" Checked="LayoutMode_Changed" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="尺寸与密度" Style="{StaticResource SettingsSectionHeaderStyle}" />
                                <Border Style="{StaticResource SettingsFieldRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="图标大小" Style="{StaticResource SettingsFieldTitleStyle}" /><TextBlock Text="启动项图标的显示尺寸。" Style="{StaticResource SettingsFieldDescriptionStyle}" /></StackPanel><Slider x:Name="IconSizeSlider" Grid.Column="1" Tag="iconSize" Minimum="24" Maximum="96" TickFrequency="1" ValueChanged="NumericSettingSlider_ValueChanged" /><TextBlock x:Name="IconSizeValue" Grid.Column="2" Style="{StaticResource ValueTextStyle}" /></Grid></Border>
                                <Border Style="{StaticResource SettingsFieldRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="卡片宽度" Style="{StaticResource SettingsFieldTitleStyle}" /><TextBlock Text="网格与卡片模式的项目宽度。" Style="{StaticResource SettingsFieldDescriptionStyle}" /></StackPanel><Slider x:Name="CardWidthSlider" Grid.Column="1" Tag="cardWidth" Minimum="72" Maximum="220" TickFrequency="1" ValueChanged="NumericSettingSlider_ValueChanged" /><TextBlock x:Name="CardWidthValue" Grid.Column="2" Style="{StaticResource ValueTextStyle}" /></Grid></Border>
                                <Border Style="{StaticResource SettingsFieldRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="卡片高度" Style="{StaticResource SettingsFieldTitleStyle}" /><TextBlock Text="项目卡片的固定高度。" Style="{StaticResource SettingsFieldDescriptionStyle}" /></StackPanel><Slider x:Name="CardHeightSlider" Grid.Column="1" Tag="cardHeight" Minimum="56" Maximum="180" TickFrequency="1" ValueChanged="NumericSettingSlider_ValueChanged" /><TextBlock x:Name="CardHeightValue" Grid.Column="2" Style="{StaticResource ValueTextStyle}" /></Grid></Border>
                                <Border Style="{StaticResource SettingsFieldRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="文字大小" Style="{StaticResource SettingsFieldTitleStyle}" /><TextBlock Text="项目标题与辅助信息的基础字号。" Style="{StaticResource SettingsFieldDescriptionStyle}" /></StackPanel><Slider x:Name="TextSizeSlider" Grid.Column="1" Tag="textSize" Minimum="11" Maximum="20" TickFrequency="1" ValueChanged="NumericSettingSlider_ValueChanged" /><TextBlock x:Name="TextSizeValue" Grid.Column="2" Style="{StaticResource ValueTextStyle}" /></Grid></Border>
                                <Border Style="{StaticResource SettingsFieldRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="项目间距" Style="{StaticResource SettingsFieldTitleStyle}" /><TextBlock Text="同一行项目之间的水平留白。" Style="{StaticResource SettingsFieldDescriptionStyle}" /></StackPanel><Slider x:Name="ItemSpacingSlider" Grid.Column="1" Tag="itemSpacing" Minimum="0" Maximum="64" TickFrequency="1" ValueChanged="NumericSettingSlider_ValueChanged" /><TextBlock x:Name="ItemSpacingValue" Grid.Column="2" Style="{StaticResource ValueTextStyle}" /></Grid></Border>
                                <Border Style="{StaticResource SettingsFieldRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="行间距" Style="{StaticResource SettingsFieldTitleStyle}" /><TextBlock Text="项目行之间的垂直留白。" Style="{StaticResource SettingsFieldDescriptionStyle}" /></StackPanel><Slider x:Name="RowSpacingSlider" Grid.Column="1" Tag="rowSpacing" Minimum="0" Maximum="80" TickFrequency="1" ValueChanged="NumericSettingSlider_ValueChanged" /><TextBlock x:Name="RowSpacingValue" Grid.Column="2" Style="{StaticResource ValueTextStyle}" /></Grid></Border>
                                <Border Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="内容边距" Style="{StaticResource SettingsFieldTitleStyle}" /><TextBlock Text="主内容区域四周的安全留白。" Style="{StaticResource SettingsFieldDescriptionStyle}" /></StackPanel><Slider x:Name="ContentPaddingSlider" Grid.Column="1" Tag="contentPadding" Minimum="8" Maximum="40" TickFrequency="1" ValueChanged="NumericSettingSlider_ValueChanged" /><TextBlock x:Name="ContentPaddingValue" Grid.Column="2" Style="{StaticResource ValueTextStyle}" /></Grid></Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="项目信息" Style="{StaticResource SettingsSectionHeaderStyle}" />
                                <Border Style="{StaticResource SettingsFieldRowStyle}"><Grid><TextBlock Text="显示项目标题" Style="{StaticResource SettingsFieldTitleStyle}" /><CheckBox x:Name="ShowTitleCheck" Tag="showItemTitle" HorizontalAlignment="Right" Style="{StaticResource SettingsCheckBoxStyle}" Checked="BooleanSettingChanged" Unchecked="BooleanSettingChanged" /></Grid></Border>
                                <Border Style="{StaticResource SettingsFieldRowStyle}"><Grid><TextBlock Text="显示完整名称" Style="{StaticResource SettingsFieldTitleStyle}" /><CheckBox x:Name="ShowFullNameCheck" Tag="showFullItemName" HorizontalAlignment="Right" Style="{StaticResource SettingsCheckBoxStyle}" Checked="BooleanSettingChanged" Unchecked="BooleanSettingChanged" /></Grid></Border>
                                <Border Padding="0,12"><Grid><TextBlock Text="显示快捷标记" Style="{StaticResource SettingsFieldTitleStyle}" /><CheckBox x:Name="ShowShortcutBadgeCheck" Tag="showShortcutBadge" HorizontalAlignment="Right" Style="{StaticResource SettingsCheckBoxStyle}" Checked="BooleanSettingChanged" Unchecked="BooleanSettingChanged" /></Grid></Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="GroupsPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="分组导航" Style="{StaticResource SettingsSectionHeaderStyle}" />
                                <Border Style="{StaticResource SettingsFieldRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="分组位置" Style="{StaticResource SettingsFieldTitleStyle}" /><TextBlock Text="分组标签可放在主界面顶部或左侧。" Style="{StaticResource SettingsFieldDescriptionStyle}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><RadioButton x:Name="GroupTopRadio" GroupName="GroupLayout" Tag="top" Content="顶部" Style="{StaticResource ChoiceChipStyle}" Checked="GroupLayout_Changed" /><RadioButton x:Name="GroupLeftRadio" GroupName="GroupLayout" Tag="left" Content="左侧" Style="{StaticResource ChoiceChipStyle}" Checked="GroupLayout_Changed" /></StackPanel></Grid></Border>
                                <Border Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="切换方式" Style="{StaticResource SettingsFieldTitleStyle}" /><TextBlock Text="点击切换更稳定；悬停切换更快捷。" Style="{StaticResource SettingsFieldDescriptionStyle}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><RadioButton x:Name="GroupClickRadio" GroupName="GroupSwitchMode" Tag="click" Content="点击" Style="{StaticResource ChoiceChipStyle}" Checked="GroupSwitchMode_Changed" /><RadioButton x:Name="GroupHoverRadio" GroupName="GroupSwitchMode" Tag="hover" Content="悬停" Style="{StaticResource ChoiceChipStyle}" Checked="GroupSwitchMode_Changed" /></StackPanel></Grid></Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="标签尺寸" Style="{StaticResource SettingsSectionHeaderStyle}" />
                                <Border Style="{StaticResource SettingsFieldRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="标签大小" Style="{StaticResource SettingsFieldTitleStyle}" /><TextBlock Text="顶部标签高度或左侧标签行高。" Style="{StaticResource SettingsFieldDescriptionStyle}" /></StackPanel><Slider x:Name="GroupLabelSizeSlider" Grid.Column="1" Tag="groupLabelSize" Minimum="28" Maximum="56" TickFrequency="1" ValueChanged="NumericSettingSlider_ValueChanged" /><TextBlock x:Name="GroupLabelSizeValue" Grid.Column="2" Style="{StaticResource ValueTextStyle}" /></Grid></Border>
                                <Border Style="{StaticResource SettingsFieldRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="标签字体大小" Style="{StaticResource SettingsFieldTitleStyle}" /><TextBlock Text="分组名称的字号。" Style="{StaticResource SettingsFieldDescriptionStyle}" /></StackPanel><Slider x:Name="GroupLabelFontSizeSlider" Grid.Column="1" Tag="groupLabelFontSize" Minimum="11" Maximum="20" TickFrequency="1" ValueChanged="NumericSettingSlider_ValueChanged" /><TextBlock x:Name="GroupLabelFontSizeValue" Grid.Column="2" Style="{StaticResource ValueTextStyle}" /></Grid></Border>
                                <Border Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="左侧导航宽度" Style="{StaticResource SettingsFieldTitleStyle}" /><TextBlock Text="仅当分组位于左侧时生效。" Style="{StaticResource SettingsFieldDescriptionStyle}" /></StackPanel><Slider x:Name="GroupNavigationWidthSlider" Grid.Column="1" Tag="groupNavigationWidth" Minimum="96" Maximum="220" TickFrequency="1" IsEnabled="{Binding IsLeftNavigationWidthEnabled}" ValueChanged="NumericSettingSlider_ValueChanged" /><TextBlock x:Name="GroupNavigationWidthValue" Grid.Column="2" Style="{StaticResource ValueTextStyle}" /></Grid></Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="TransparencyPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="透明模式" Style="{StaticResource SettingsSectionHeaderStyle}" />
                                <Border Style="{StaticResource SettingsFieldRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="应用范围" Style="{StaticResource SettingsFieldTitleStyle}" /><TextBlock Text="分层模式只影响内容表面；整窗模式连同窗口一起透明。" Style="{StaticResource SettingsFieldDescriptionStyle}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><RadioButton x:Name="LayeredTransparencyRadio" GroupName="TransparencyMode" Tag="layered" Content="分层透明" Style="{StaticResource ChoiceChipStyle}" Checked="TransparencyMode_Changed" /><RadioButton x:Name="WholeWindowTransparencyRadio" GroupName="TransparencyMode" Tag="wholeWindow" Content="整窗透明" Style="{StaticResource ChoiceChipStyle}" Checked="TransparencyMode_Changed" /></StackPanel></Grid></Border>
                                <Border Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="当前模式透明度" Style="{StaticResource SettingsFieldTitleStyle}" /><TextBlock Text="两个模式分别记忆数值；推荐 85%，最低 55%。" Style="{StaticResource SettingsFieldDescriptionStyle}" /></StackPanel><Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.55" Maximum="1" SmallChange="0.01" LargeChange="0.05" ValueChanged="OpacitySlider_ValueChanged" /><StackPanel Grid.Column="2" Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Center"><TextBox x:Name="OpacityPercentBox" Width="58" HorizontalContentAlignment="Right" LostFocus="OpacityPercentBox_LostFocus" KeyDown="OpacityPercentBox_KeyDown" /><TextBlock Margin="4,0,0,0" Text="%" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel></Grid></Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="恢复推荐值" Style="{StaticResource SettingsFieldTitleStyle}" />
                                    <TextBlock Text="只将当前透明模式恢复到 85%，不会覆盖另一模式。" Style="{StaticResource SettingsFieldDescriptionStyle}" />
                                </StackPanel>
                                <Button x:Name="ResetOpacityButton" Grid.Column="1" Content="恢复 85%" Click="ResetOpacity_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="InteractionPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="启动项交互" Style="{StaticResource SettingsSectionHeaderStyle}" />
                                <Border Style="{StaticResource SettingsFieldRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="打开方式" Style="{StaticResource SettingsFieldTitleStyle}" /><TextBlock Text="选择单击或双击打开启动项。" Style="{StaticResource SettingsFieldDescriptionStyle}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><RadioButton x:Name="SingleClickOpenRadio" GroupName="OpenItemMode" Tag="single" Content="单击" Style="{StaticResource ChoiceChipStyle}" Checked="OpenMode_Changed" /><RadioButton x:Name="DoubleClickOpenRadio" GroupName="OpenItemMode" Tag="double" Content="双击" Style="{StaticResource ChoiceChipStyle}" Checked="OpenMode_Changed" /></StackPanel></Grid></Border>
                                <Border Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="动画" Style="{StaticResource SettingsFieldTitleStyle}" /><TextBlock Text="跟随系统会尊重 Windows 动画与性能偏好。" Style="{StaticResource SettingsFieldDescriptionStyle}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><RadioButton x:Name="SystemAnimationRadio" GroupName="AnimationMode" Tag="system" Content="跟随系统" Style="{StaticResource ChoiceChipStyle}" Checked="AnimationMode_Changed" /><RadioButton x:Name="OnAnimationRadio" GroupName="AnimationMode" Tag="on" Content="开启" Style="{StaticResource ChoiceChipStyle}" Checked="AnimationMode_Changed" /><RadioButton x:Name="OffAnimationRadio" GroupName="AnimationMode" Tag="off" Content="关闭" Style="{StaticResource ChoiceChipStyle}" Checked="AnimationMode_Changed" /></StackPanel></Grid></Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="StartupPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="快捷键" Style="{StaticResource SettingsSectionHeaderStyle}" />
                                <Border Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="全局快捷键" Style="{StaticResource SettingsFieldTitleStyle}" /><TextBlock Text="聚焦输入框后按下新的组合键。" Style="{StaticResource SettingsFieldDescriptionStyle}" /></StackPanel><TextBox x:Name="HotkeyBox" Grid.Column="1" IsReadOnly="True" KeyDown="HotkeyBox_KeyDown" /></Grid></Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="登录时启动" Style="{StaticResource SettingsFieldTitleStyle}" />
                                    <TextBlock Text="保存设置后同步 Windows 启动项；取消不会修改系统状态。" Style="{StaticResource SettingsFieldDescriptionStyle}" />
                                </StackPanel>
                                <CheckBox x:Name="RunAtStartupCheck" Grid.Column="1" Tag="startWithWindows" Style="{StaticResource SettingsCheckBoxStyle}" Checked="BooleanSettingChanged" Unchecked="BooleanSettingChanged" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PerformancePanel" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="图标缓存" Style="{StaticResource SettingsSectionHeaderStyle}" />
                                <Border Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="清空内存缓存" Style="{StaticResource SettingsFieldTitleStyle}" />
                                            <TextBlock Text="LanFlow 使用最多 256 项的 LRU 图标缓存，减少滚动与切换分组时的重复解码。清空后图标会按需重新加载。" Style="{StaticResource SettingsFieldDescriptionStyle}" />
                                            <TextBlock x:Name="CacheStatusText" Margin="0,6,18,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </StackPanel>
                                        <Button x:Name="ClearIconCacheButton" Grid.Column="1" Content="清空缓存" Click="ClearIconCache_Click" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel Margin="0,8">
                                <TextBlock Text="性能建议" Style="{StaticResource SettingsSectionHeaderStyle}" />
                                <TextBlock Text="在 Windows 11 性能模式下，建议将动画设为“跟随系统”或“关闭”；85% 透明度兼顾层次感与文字可读性。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="56" Height="56" Margin="0,0,16,0" CornerRadius="14" Background="{DynamicResource AccentBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="LanFlow" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock x:Name="VersionText" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel Margin="0,8">
                                <TextBlock Text="开源与更新" Style="{StaticResource SettingsSectionHeaderStyle}" />
                                <TextBlock Text="LanFlow 是一款面向 Windows 的开源启动器，支持分组导航、快速搜索与自定义主题。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                                <TextBlock Margin="0,14,0,0" FontSize="13"><Hyperlink NavigateUri="https://github.com/ZergZFZ/LanFlow" RequestNavigate="AboutLink_RequestNavigate" Foreground="{DynamicResource FocusBorderBrush}">github.com/ZergZFZ/LanFlow</Hyperlink></TextBlock>
                                <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                                    <Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click" />
                                    <TextBlock x:Name="UpdateStatusText" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border x:Name="SettingsFooter"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Style="{StaticResource SettingsFooterStyle}">
            <Grid>
                <TextBlock VerticalAlignment="Center"
                           Text="更改会即时预览；保存后才会写入配置。"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Content="取消" IsCancel="True" />
                    <Button x:Name="SaveButton"
                            Margin="8,0,0,0"
                            Content="保存设置"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True"
                            IsEnabled="{Binding HasChanges}"
                            Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
