<Window x:Class="LanFlow.Desktop.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择颜色" Width="430" Height="510" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#171B28" Foreground="#F5F7FC"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp" Deactivated="Window_Deactivated">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/></Style>
        <Style TargetType="TextBox"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="10,0"/><Setter Property="Background" Value="#22283A"/><Setter Property="Foreground" Value="#F5F7FC"/><Setter Property="BorderBrush" Value="#38425B"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="14,0"/><Setter Property="Background" Value="#22283A"/><Setter Property="Foreground" Value="#F5F7FC"/><Setter Property="BorderBrush" Value="#38425B"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="root" Property="Background" Value="#2B3247"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Background" Value="#35405E"/><Setter Property="BorderBrush" Value="#5A6685"/></Style>
    </Window.Resources>
    <Border Margin="10" Padding="22" Background="#171B28" BorderBrush="#343B50" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="选择颜色" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Margin="0,5,0,0" Text="拖动色相和明暗区域，或直接输入 HEX 色值。" Foreground="#ADB5C7" FontSize="12"/>
            </StackPanel>
            <Grid Grid.Row="2" Height="260">
                <Border x:Name="Spectrum" Background="Transparent" CornerRadius="9" MouseLeftButtonDown="Spectrum_MouseLeftButtonDown" MouseMove="Spectrum_MouseMove">
                    <Grid ClipToBounds="True">
                        <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0"/><GradientStop x:Name="HueStop" Color="#FF0000" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                        <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#FF000000" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                        <Canvas IsHitTestVisible="False"><Ellipse x:Name="SpectrumMarker" Width="16" Height="16" Stroke="White" StrokeThickness="2" Fill="Transparent"/></Canvas>
                    </Grid>
                </Border>
                <Border Width="58" Height="58" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Background="#22283A" CornerRadius="8" BorderBrush="#66718A" BorderThickness="1"><Border x:Name="PreviewSwatch" Margin="5" CornerRadius="5"/></Border>
            </Grid>
            <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                <Border x:Name="HueBar" Height="18" VerticalAlignment="Center" CornerRadius="9" ClipToBounds="True" MouseLeftButtonDown="HueBar_MouseLeftButtonDown" MouseMove="HueBar_MouseMove"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF0000" Offset="0"/><GradientStop Color="#FFFF00" Offset="0.17"/><GradientStop Color="#FF00FF00" Offset="0.33"/><GradientStop Color="#FF00FFFF" Offset="0.5"/><GradientStop Color="#FF0000FF" Offset="0.67"/><GradientStop Color="#FFFF00FF" Offset="0.83"/><GradientStop Color="#FFFF0000" Offset="1"/></LinearGradientBrush></Border.Background><Border x:Name="HueMarker" Width="4" Background="White" HorizontalAlignment="Left" IsHitTestVisible="False"/></Border>
                <TextBox x:Name="HexBox" Grid.Column="2" TextChanged="HexBox_TextChanged"/>
            </Grid>
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="取消" IsCancel="True"/>
                <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="应用颜色" IsDefault="True" Click="Apply_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
