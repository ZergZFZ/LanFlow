<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LanFlow</AssemblyName>
    <RootNamespace>LanFlow.Desktop</RootNamespace>
  <Version>1.4.0</Version>
  <AssemblyVersion>1.4.0.0</AssemblyVersion>
  <FileVersion>1.4.0.0</FileVersion>
    <ApplicationIcon>Assets\LanFlow.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\LanFlow.png" />
    <EmbeddedResource Include="Assets\LanFlow.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LanFlow.Core\LanFlow.Core.csproj" />
  </ItemGroup>
</Project>
