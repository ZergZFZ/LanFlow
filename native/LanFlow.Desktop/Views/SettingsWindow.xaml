<Window x:Class="LanFlow.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanFlow 设置"
        Width="440"
        SizeToContent="Height"
        MinHeight="510"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#171B28"
        Foreground="#F5F7FC">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDE3F0" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="Foreground" Value="#DDE3F0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDE3F0" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="19" FontWeight="SemiBold" Text="设置" />
            <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="#9DA8BE" Text="这些偏好会自动保存并在下次打开时恢复。" />
        </StackPanel>

        <Border Grid.Row="2" Padding="16" Background="#22283A" BorderBrush="#38425B" BorderThickness="1" CornerRadius="9">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="配色" />
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <RadioButton x:Name="DarkThemeRadio" Content="深色" GroupName="Theme" />
                    <RadioButton x:Name="LightThemeRadio" Content="浅色" GroupName="Theme" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Padding="16" Background="#22283A" BorderBrush="#38425B" BorderThickness="1" CornerRadius="9">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="外观" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="OpacitySlider" Minimum="55" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OpacitySlider_ValueChanged" />
                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:0}%}" />
                </Grid>
                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#9DA8BE" Text="调整启动面板透明度" />
                <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="快捷方式" />
                <CheckBox x:Name="ShowShortcutBadgeCheckBox" Margin="0,12,0,0" Content="显示图标左下角的快捷方式标志" />
                <CheckBox x:Name="ShowFullItemNameCheckBox" Margin="0,10,0,0" Content="显示快捷方式全名" />
            </StackPanel>
        </Border>

        <Border Grid.Row="6" Padding="16" Background="#22283A" BorderBrush="#38425B" BorderThickness="1" CornerRadius="9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontWeight="SemiBold" Text="分组位置" />
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LeftGroupLayoutRadio" Content="靠左" GroupName="GroupLayout" />
                        <RadioButton x:Name="TopGroupLayoutRadio" Content="靠上" GroupName="GroupLayout" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Width="68" Height="30" Margin="0,0,8,0" IsCancel="True" Content="取消" />
                        <Button Width="68" Height="30" IsDefault="True" Background="#4B6EA9" BorderBrush="#5F85C4" Click="Save_Click" Content="保存" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
