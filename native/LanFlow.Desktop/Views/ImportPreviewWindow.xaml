<Window x:Class="LanFlow.Desktop.Views.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入清单预览"
        Width="920"
        Height="650"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="16" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="导入清单预览" />
                <StackPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="文件：" />
                    <TextBlock MaxWidth="430" FontWeight="SemiBold" Text="{Binding SourceFileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceFilePath}" />
                    <TextBlock Margin="20,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="格式：" />
                    <TextBlock Text="{Binding SchemaVersion}" />
                    <TextBlock Margin="20,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="分组：" />
                    <TextBlock Text="{Binding TotalGroupCount}" />
                    <TextBlock Margin="20,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="项目：" />
                    <TextBlock Text="{Binding TotalItemCount}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="14" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox VerticalAlignment="Center"
                                          IsThreeState="True"
                                          IsEnabled="{Binding CanSelect}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#B7791F" Text="{Binding NoticeText}" />
                                </StackPanel>
                                <Border Grid.Column="2" Padding="8,3" Background="{StaticResource AccentSoftBrush}" CornerRadius="10">
                                    <TextBlock FontSize="11" Foreground="{StaticResource AccentBrush}" Text="{Binding StatusText}" />
                                </Border>
                            </Grid>

                            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,9" BorderBrush="#EEF1F5" BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox VerticalAlignment="Top"
                                                          IsEnabled="{Binding CanSelect}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Column="1" Margin="10,0,12,0" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayPath}" />
                                                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#C2410C" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding StatusText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="4" Padding="14" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding SummaryText}" TextWrapping="Wrap" />
                <TextBlock x:Name="ImportErrorText" Grid.Row="1" Grid.Column="0" Margin="0,8,16,0" Foreground="#B91C1C" TextWrapping="Wrap" Visibility="Collapsed" />
                <StackPanel Grid.RowSpan="2" Grid.Column="1" Margin="24,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <Button MinWidth="82" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click" Content="取消" />
                    <Button x:Name="ConfirmImportButton"
                            MinWidth="104"
                            Style="{StaticResource PrimaryButton}"
                            IsDefault="True"
                            IsEnabled="{Binding CanConfirm}"
                            Click="ConfirmImport_Click"
                            Content="确认导入" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>