<Window x:Class="FlickD.Desktop.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        IsHitTestVisible="False">
    <Border Background="#F21C1C22" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="16" Padding="16,9">
        <TextBlock x:Name="PillText"
                   Foreground="#F2FFFFFF"
                   FontSize="13"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="420" />
    </Border>
</Window>
